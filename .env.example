# Copy to .env (never commit .env). Defaults match a fresh XAMPP install.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dokankhata

# API
API_PORT=3001
SESSION_DAYS=7
# Set to "true" only behind HTTPS
COOKIE_SECURE=false

# Optional: full path to the mysql client if db:reset can't find XAMPP's
# MYSQL_BIN=C:\xampp\mysql\bin\mysql.exe
